<% layout('/layouts/boilerplate') %>
<body>
  <h1>Listing details</h1>
  <div class="row">
    <div class="col-8 offset-2">
      <div class="card show-card">
        <img src="<%= listing.image %>" class="card-img-top" alt="..." />
        <div class="card-body">
          <h4 class="card-title"><%= listing.title %></h4>
          <br />
          <p class="card-text">
            <%= listing.description %> <br />
            <br />
            <b>Price:</b> &#8377; <%= listing.price.toLocaleString('en-IN') %>
            <br />
            <br />
            <b>Location:</b> <%= listing.location %> <br />
            <br />
            <b>Country:</b> <%= listing.country %> <br />
            <br />
          </p>
        </div>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col offset-2">
      <form action="/listings/<%= listing._id %>/edit">
        <button class="btn add-btn">Edit</button>
      </form>
    </div>
    <br />
    <br />
    <div class="col-8">
      <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  </div>
  <hr />

  <div class="row">
    <h4>Leave a rating!!</h4>
    <div class="col-6 offset-2">
      <form action="/listings/<%= listing._id %>/reviews" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" id="rating" class="form-control form-range" min="1" max="5" step="1" name="rating" required />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Give a valid rating.</div>
        </div>
        <div class="mb-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea
            name="comment"
            id="comment"
            rows="5"
            cols="10"
            class="form-control"
            required
          ></textarea>
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Enter a comment.</div>
        </div>
        <div class="mb-3">
          <label for="createdAt" class="form-label">CreatedAt:</label>
          <input type="datetime-local" id="createdAt" class="form-control" name="createdAt" />
          <div class="valid-feedback">Looks good,Present date and time by default!</div>
          <div class="invalid-feedback">Select a valid date.</div>
        </div>
        <button class="btn add-btn mb-3">Submit</button>
      </form>
    </div>
  </div>
  <hr>
  <div class="row">
    <div class="col-12 offset-2">
      <h4>All reviews</h4>
       <% for(review of listing.reviews){ %>
        <div class="row">
          <div class="card col-6 p-2" style="width: 20rem;">
            <h5 class="card-title">John Cena</h5>
            <div class="card-body">
               <p class="card-text"><%= review.comment %></p>
               <p class="card-text"> <b>Rating:</b><%= review.rating %></p>
               <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                <button class="btn btn-dark">Delete</button>
               </form>
            </div>
            </div>
             <% } %>
    </div>
  </div>
</body>
