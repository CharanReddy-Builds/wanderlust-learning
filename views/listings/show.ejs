<% layout('/layouts/boilerplate') %>

<body>
  <div class="container mt-5">

<!-- Listing -->
<div class="row">
  <div class="col-lg-6 col-md-8 col-12 mx-auto">

    <h1>Listing details</h1>

    <div class="card show-card mt-4">

      <img
        src="<%= listing.image.url %>"
        class="card-img-top"
        alt="..."
        style="height: 300px; object-fit: cover;"
      />

      <div class="card-body">

        <h4 class="card-title">
          <%= listing.title %>
        </h4>

        <p class="card-text">
          <b>Owned by </b><%= listing.owner.username %>
        </p>

        <p class="card-text">
          <%= listing.description %>
        </p>

        <p class="card-text">
          <b>Price:</b> &#8377;
          <%= listing.price.toLocaleString('en-IN') %>
        </p>

        <p class="card-text">
          <b>Location:</b> <%= listing.location %>
        </p>

        <p class="card-text">
          <b>Country:</b> <%= listing.country %>
        </p>

      </div>
    </div>

  </div>
</div>


<!-- Edit / Delete -->
<% if(currUser&&currUser._id.equals(listing.owner._id)){ %>

  <div class="row mt-3 mb-4">
    <div class="col-lg-6 col-md-8 col-12 mx-auto d-flex gap-3">

      <form action="/listings/<%= listing._id %>/edit">
        <button class="btn add-btn">
          Edit
        </button>
      </form>

      <form
        action="/listings/<%= listing._id %>?_method=DELETE"
        method="post"
      >
        <button class="btn btn-dark">
          Delete
        </button>
      </form>

    </div>
  </div>

<% } %>


<hr class="my-4">


<!-- Review form -->
<div class="row">
  <div class="col-lg-6 col-md-8 col-12 mx-auto">

    <% if(currUser){ %>

      <h4>Leave a rating!!</h4>

      <form
        action="/listings/<%= listing._id %>/reviews"
        method="post"
        class="needs-validation"
        novalidate
      >

        <div class="mb-3">
          <label for="rating" class="form-label">
            Rating
          </label>
          <fieldset class="starability-checkmark">
          <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="rating" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="rating" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="rating" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="rating" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="rating" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>

          <div class="valid-feedback">
            Looks good!
          </div>

          <div class="invalid-feedback">
            Give a valid rating.
          </div>

        </div>


        <div class="mb-3">

          <label for="comment" class="form-label">
            Comment
          </label>

          <textarea
            name="comment"
            id="comment"
            rows="4"
            class="form-control"
            required
          ></textarea>

          <div class="valid-feedback">
            Looks good!
          </div>

          <div class="invalid-feedback">
            Enter a comment.
          </div>

        </div>


        <div class="mb-3">

          <label for="createdAt" class="form-label">
            CreatedAt:
          </label>

          <input
            type="datetime-local"
            id="createdAt"
            class="form-control"
            name="createdAt"
          />

          <div class="valid-feedback">
            Looks good,Present date and time by default!
          </div>

          <div class="invalid-feedback">
            Select a valid date.
          </div>

        </div>


        <button class="btn add-btn mb-3">
          Submit
        </button>

      </form>

    <% } %>

  </div>
</div>


<!-- All reviews -->
<div class="row">
  <div class="col-lg-8 col-md-10 col-12 mx-auto">

    <h4 class="mb-3">
      All reviews
    </h4>

    <div class="row g-3">

      <% for(review of listing.reviews){ %>

        <div class="col-md-6">

          <div class="card h-100 p-2">

            <h5 class="card-title ms-3">
              <%=review.author.username%>
            </h5>

            <div class="card-body">
                  <p class="starability-result card-text" data-rating="<%= review.rating %>">
                        Rated: 3 stars
                  </p>

                  <p class="card-text">
                    <%= review.comment %>
                  </p>

              

              <% if(currUser&&currUser._id.equals(review.author._id)){ %>
              <form
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="post"
              >
                <button class="btn btn-dark">
                  Delete
                </button>
              </form>
              <% } %>

            </div>

          </div>

        </div>

      <% } %>

    </div>

  </div>
</div>


  </div>
</body>
