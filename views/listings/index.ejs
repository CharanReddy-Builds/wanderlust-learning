
<% layout('/layouts/boilerplate') %>
    <div class="row">
    <%for(listing of listings){ %>
    <!-- <li><a href="/listings/<%=listing.id%>"><%= listing.title %></a></li> -->
    <div class="col-12 col-md-6 col-lg-4">
    <a href="/listings/<%= listing._id %>">
        <div class="card">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="...">
        <div class="card-body">
            <h5 class="card-title"><%= listing.title %></h5>
            <p class="card-price">₹ <%= listing.price %>/night &nbsp; <i class="tax-info">+ 18% GST </i></p>
        </div>
        </div>
    </a>
    </div>
<% } %>
    </div>

    <script>
        let taxInfos=document.getElementsByClassName("tax-info")
        let taxCheckbox=document.getElementById("switchCheckDefault")
        taxCheckbox.addEventListener("click",()=>{
            for(info of taxInfos){
            if(taxCheckbox.checked){
                info.style.display='inline-block'
            } else{
                info.style.display="none"
            }
        }
        })
    </script>

